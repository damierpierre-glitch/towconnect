# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role (secret!) — required for payment
# processing (lib/supabase/admin.ts) and for scripts/rls-integration-test.ts.
# Never expose this to the client; server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe — https://dashboard.stripe.com/apikeys (use test-mode keys in dev)
# Secret key — server-only, never sent to the browser.
STRIPE_SECRET_KEY=
# Publishable key — safe to expose, used by Stripe.js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint's settings once created (Dashboard > Developers >
# Webhooks), or printed by `stripe listen` in local dev. Required to verify
# that incoming webhook requests actually came from Stripe.
STRIPE_WEBHOOK_SECRET=
# Payments are entirely optional/inert until STRIPE_SECRET_KEY is set — the
# app builds and runs every other feature with none of the above configured,
# same as NEXT_PUBLIC_MAPBOX_TOKEN.

# Shared secret the scheduler sends to the Edge Functions in the x-cron-secret
# header (see supabase/functions/dispatch-tick/README.md). The app itself never
# reads it; it lives here so the same value can be replayed with curl when
# verifying a deployment. Set it in Supabase under Edge Functions > Secrets.
CRON_SECRET=
